# Copy this file to .env and adjust if needed.
# Inside the Codespace/dev container, "postgres" is the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://sentinelx:sentinelx_dev_pw@localhost:5432/sentinelx

# Redis for the background worker (Arq -- docs/DECISIONS.md). The default
# matches the docker-compose redis service; the dev launcher starts it.
REDIS_URL=redis://localhost:6379/0

# SMTP credentials for sending email-verification / password-reset codes.
# Leave blank to skip real email sending -- the backend just prints the
# code to the server console instead, so registration/login still work
# during local development.
SMTP_USER=
SMTP_PASSWORD=

# "dev" (default) or e.g. "production"/"staging". Outside ENV=dev, a real
# SECRET_KEY below is REQUIRED -- the server refuses to start with the
# hardcoded default (see app/config.py's _require_secret_key_in_non_dev).
# ENV=dev

# AI analysis (AI SOC Analyst milestone, docs/DECISIONS.md "provider").
# All defaults are safe: OPENAI_API_KEY blank means AI is UNAVAILABLE and
# every triage falls back to the deterministic rule-based summary --
# nothing ever calls the network. AI is additionally gated per
# organization by OrganizationSettings.ai_enabled (default OFF; owners
# flip it via PATCH /api/v1/organization/ai-settings).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_REQUEST_TIMEOUT_SECONDS=30
# AI_MAX_RETRIES=2
# AI_MAX_OUTPUT_TOKENS=800
# Platform-default spend caps when an organization has no explicit cap
# (NULL organization_settings.ai_*_cost_cap_usd). NULL never means
# unlimited; 0 is a valid cap ("spend nothing").
# AI_DEFAULT_DAILY_COST_CAP_USD=2.0
# AI_DEFAULT_MONTHLY_COST_CAP_USD=10.0
# Character budget for the untrusted alert-event block inside the prompt.
# AI_DATA_BLOCK_MAX_CHARS=12000

# Used to sign login tokens. Optional while ENV=dev -- Settings falls back
# to a hardcoded dev value (see app/config.py) which is fine for a
# local/college project. Required (and must not be the default) once ENV
# is anything other than "dev".
# SECRET_KEY=

# Where emailed links point (invitation accept links, etc.). Defaults to
# http://localhost:5173 -- fine for solo dev, but a link only opens on the
# machine running the dev server. You normally never set this by hand:
# `npm run dev:share` sets it per session to the LAN/tunnel URL so a phone
# can open invitation emails. See README "Sharing the dev environment".
# FRONTEND_URL=
